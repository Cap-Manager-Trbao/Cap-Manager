rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTelegramTemplates(t) {
      return t is map
        && t.keys().hasOnly(['capPublish', 'capUpdate', 'shiftReminder', 'testMessage'])
        && (!('capPublish' in t) || (t.capPublish is string && t.capPublish.size() <= 800))
        && (!('capUpdate' in t) || (t.capUpdate is string && t.capUpdate.size() <= 800))
        && (!('shiftReminder' in t) || (t.shiftReminder is string && t.shiftReminder.size() <= 800))
        && (!('testMessage' in t) || (t.testMessage is string && t.testMessage.size() <= 800));
    }

    function isValidTimeOrEmpty(val) {
      return val is string && val.size() <= 5 && (val == '' || val.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'));
    }

    function isValidGroupSettings(s) {
      return s is map
        && s.keys().hasAll([
          'leaderPriority',
          'newMemberMode',
          'capBalanceLevel',
          'pointBalanceLevel',
          'useShiftMatching',
          'optimizationTrials',
          'autoSaveHistoryOnDistribute'
        ])
        && s.keys().hasOnly([
          'leaderPriority',
          'newMemberMode',
          'capBalanceLevel',
          'pointBalanceLevel',
          'useShiftMatching',
          'useRolloverFairness',
          'optimizationTrials',
          'autoSaveHistoryOnDistribute',
          'telegramEnabled',
          'telegramChatId',
          'telegramShiftReminderEnabled',
          'telegramShiftReminderTime',
          'telegramInteractiveEnabled',
          'telegramDeadlineReminderTime',
          'telegramDailySummaryTime',
          'aiButlerEnabled',
          'telegramTemplates'
        ])
        && s.leaderPriority in ['normal', 'low', 'medium', 'high']
        && s.newMemberMode in ['less', 'normal']
        && s.capBalanceLevel in ['high', 'medium']
        && s.pointBalanceLevel in ['high', 'medium']
        && s.useShiftMatching is bool
        && (!('useRolloverFairness' in s) || s.useRolloverFairness is bool)
        && s.optimizationTrials is number && s.optimizationTrials >= 1 && s.optimizationTrials <= 100
        && s.autoSaveHistoryOnDistribute is bool
        && (!('telegramEnabled' in s) || s.telegramEnabled is bool)
        && (!('telegramChatId' in s) || (s.telegramChatId is string && s.telegramChatId.size() <= 64 && (s.telegramChatId == '' || s.telegramChatId.matches('^(\\-?[0-9]{5,20}|@[a-zA-Z0-9_]{5,32})$'))))
        && (!('telegramShiftReminderEnabled' in s) || s.telegramShiftReminderEnabled is bool)
        && (!('telegramShiftReminderTime' in s) || isValidTimeOrEmpty(s.telegramShiftReminderTime))
        && (!('telegramInteractiveEnabled' in s) || s.telegramInteractiveEnabled is bool)
        && (!('telegramDeadlineReminderTime' in s) || isValidTimeOrEmpty(s.telegramDeadlineReminderTime))
        && (!('telegramDailySummaryTime' in s) || isValidTimeOrEmpty(s.telegramDailySummaryTime))
        && (!('aiButlerEnabled' in s) || s.aiButlerEnabled is bool)
        && (!('telegramTemplates' in s) || isValidTelegramTemplates(s.telegramTemplates));
    }

    function isValidMemberEntry(m) {
      return m is map
        && m.id is string && m.id.size() >= 1 && m.id.size() <= 128
        && m.name is string && m.name.size() >= 1 && m.name.size() <= 100
        && m.isLeader is bool
        && m.isNew is bool
        && m.active is bool
        && m.shifts is list && m.shifts.size() <= 5
        && m.shiftSchedule is map
        && (!('telegramUsername' in m) || (m.telegramUsername is string && m.telegramUsername.size() <= 64))
        && (!('telegramUserId' in m) || (m.telegramUserId is string && m.telegramUserId.size() <= 32));
    }

    function isValidCampaignEntry(c) {
      return c is map
        && c.id is string && c.id.size() >= 1 && c.id.size() <= 128
        && c.code is string && c.code.size() >= 1 && c.code.size() <= 50
        && c.name is string && c.name.size() >= 1 && c.name.size() <= 200
        && c.totalCap is number && c.totalCap >= 0 && c.totalCap <= 10000
        && c.pointsPerCap is number && c.pointsPerCap >= 0 && c.pointsPerCap <= 100000;
    }

    function isValidGroup(data, groupId) {
      return data is map
        && data.keys().hasAll([
          'id',
          'name',
          'description',
          'leaderUsername',
          'leaderDisplayName',
          'members',
          'campaigns',
          'matrix',
          'autoBackup',
          'settings',
          'visibility',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'name',
          'description',
          'leaderUsername',
          'leaderDisplayName',
          'members',
          'campaigns',
          'matrix',
          'autoBackup',
          'settings',
          'completions',
          'visibility',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string && data.id == groupId && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.description is string && data.description.size() <= 300
        && data.leaderUsername is string && data.leaderUsername.size() >= 3 && data.leaderUsername.size() <= 64 && data.leaderUsername.matches('^[a-zA-Z0-9_.\\-]+$')
        && data.leaderDisplayName is string && data.leaderDisplayName.size() >= 1 && data.leaderDisplayName.size() <= 120
        && data.members is list && data.members.size() <= 100
        && (data.members.size() == 0 || isValidMemberEntry(data.members[0]))
        && data.campaigns is list && data.campaigns.size() <= 200
        && (data.campaigns.size() == 0 || isValidCampaignEntry(data.campaigns[0]))
        && data.matrix is map && data.matrix.size() <= 200
        && data.autoBackup is map && data.autoBackup.size() <= 200
        && isValidGroupSettings(data.settings)
        && (!('completions' in data) || (data.completions is map && data.completions.size() <= 30))
        && data.visibility == 'shared'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidGroupCredential(data, groupId) {
      return data is map
        && data.keys().hasAll(['groupId', 'username', 'displayName', 'salt', 'passwordHash', 'updatedAt'])
        && data.keys().hasOnly(['groupId', 'username', 'displayName', 'salt', 'passwordHash', 'updatedAt'])
        && data.groupId is string && data.groupId == groupId && isValidId(data.groupId)
        && data.username is string && data.username.size() >= 3 && data.username.size() <= 64 && data.username.matches('^[a-zA-Z0-9_.\\-]+$')
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.salt is string && data.salt.size() >= 8 && data.salt.size() <= 64
        && data.passwordHash is string && data.passwordHash.size() == 64 && data.passwordHash.matches('^[a-f0-9]+$')
        && data.updatedAt is timestamp;
    }

    function isValidGroupTelegramBot(data, groupId) {
      return data is map
        && data.keys().hasAll(['groupId', 'botToken', 'botUsername', 'tokenMasked', 'encrypted', 'updatedAt'])
        && data.keys().hasOnly(['groupId', 'botToken', 'botUsername', 'tokenMasked', 'encrypted', 'updatedAt'])
        && data.groupId is string && data.groupId == groupId && isValidId(data.groupId)
        && data.botToken is string && data.botToken.size() >= 20 && data.botToken.size() <= 512
        && data.botUsername is string && data.botUsername.size() <= 64
        && data.tokenMasked is string && data.tokenMasked.size() <= 32
        && data.encrypted is bool
        && data.updatedAt is timestamp;
    }

    function isValidDateOrEmpty(val) {
      return val is string && val.size() <= 10 && (val == '' || val.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    function isValidGroupSchedulerState(data, groupId) {
      return data is map
        && data.keys().hasAll(['groupId', 'updatedAt'])
        && data.keys().hasOnly([
          'groupId',
          'lastShiftReminderDate',
          'lastShiftReminderSentAt',
          'lastShiftReminderStatus',
          'lastShiftReminderError',
          'lastCutoffNudgeDate',
          'lastDailySummaryDate',
          'lastDistributionSentDate',
          'lastDistributionMatrixHash',
          'lastDistributionSentAt',
          'updatedAt'
        ])
        && data.groupId is string && data.groupId == groupId && isValidId(data.groupId)
        && (!('lastShiftReminderDate' in data) || isValidDateOrEmpty(data.lastShiftReminderDate))
        && (!('lastShiftReminderSentAt' in data) || (data.lastShiftReminderSentAt is string && data.lastShiftReminderSentAt.size() <= 40))
        && (!('lastShiftReminderStatus' in data) || data.lastShiftReminderStatus in ['none', 'sent', 'failed'])
        && (!('lastShiftReminderError' in data) || (data.lastShiftReminderError is string && data.lastShiftReminderError.size() <= 300))
        && (!('lastCutoffNudgeDate' in data) || isValidDateOrEmpty(data.lastCutoffNudgeDate))
        && (!('lastDailySummaryDate' in data) || isValidDateOrEmpty(data.lastDailySummaryDate))
        && (!('lastDistributionSentDate' in data) || isValidDateOrEmpty(data.lastDistributionSentDate))
        && (!('lastDistributionMatrixHash' in data) || (data.lastDistributionMatrixHash is string && data.lastDistributionMatrixHash.size() <= 128))
        && (!('lastDistributionSentAt' in data) || (data.lastDistributionSentAt is string && data.lastDistributionSentAt.size() <= 40))
        && data.updatedAt is timestamp;
    }

    function isValidHistoryStats(st) {
      return st is map
        && st.keys().hasAll(['assignedTotalCap', 'expectedTotalCap', 'assignedTotalPoints', 'capSpread', 'pointSpread'])
        && st.keys().hasOnly(['assignedTotalCap', 'expectedTotalCap', 'assignedTotalPoints', 'capSpread', 'pointSpread'])
        && st.assignedTotalCap is number && st.assignedTotalCap >= 0
        && st.expectedTotalCap is number && st.expectedTotalCap >= 0
        && st.assignedTotalPoints is number && st.assignedTotalPoints >= 0
        && st.capSpread is number && st.capSpread >= 0
        && st.pointSpread is number && st.pointSpread >= 0;
    }

    function isValidHistoryRecord(data, groupId, historyId) {
      return data is map
        && data.keys().hasAll(['id', 'groupId', 'date', 'note', 'savedAt', 'members', 'campaigns', 'matrix', 'stats', 'createdAt'])
        && data.keys().hasOnly(['id', 'groupId', 'date', 'note', 'savedAt', 'members', 'campaigns', 'matrix', 'stats', 'createdAt'])
        && data.id is string && data.id == historyId && isValidId(data.id)
        && data.groupId is string && data.groupId == groupId && isValidId(data.groupId)
        && data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.note is string && data.note.size() <= 300
        && data.savedAt is string && data.savedAt.size() >= 10 && data.savedAt.size() <= 40
        && data.members is list && data.members.size() <= 100
        && (data.members.size() == 0 || isValidMemberEntry(data.members[0]))
        && data.campaigns is list && data.campaigns.size() <= 200
        && (data.campaigns.size() == 0 || isValidCampaignEntry(data.campaigns[0]))
        && data.matrix is map && data.matrix.size() <= 200
        && isValidHistoryStats(data.stats)
        && data.createdAt is timestamp;
    }

    function isValidTransfer(data, groupId, transferId) {
      return data is map
        && data.keys().hasAll([
          'id',
          'groupId',
          'date',
          'offerId',
          'offerCode',
          'offerName',
          'fromMemberId',
          'fromMemberName',
          'toMemberId',
          'toMemberName',
          'qty',
          'note',
          'source',
          'status',
          'resolvedBy',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'groupId',
          'date',
          'offerId',
          'offerCode',
          'offerName',
          'fromMemberId',
          'fromMemberName',
          'toMemberId',
          'toMemberName',
          'qty',
          'note',
          'source',
          'status',
          'resolvedBy',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string && data.id == transferId && isValidId(data.id)
        && data.groupId is string && data.groupId == groupId && isValidId(data.groupId)
        && data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.offerId is string && data.offerId.size() >= 1 && data.offerId.size() <= 128
        && data.offerCode is string && data.offerCode.size() >= 1 && data.offerCode.size() <= 50
        && data.offerName is string && data.offerName.size() <= 200
        && data.fromMemberId is string && data.fromMemberId.size() >= 1 && data.fromMemberId.size() <= 128
        && data.fromMemberName is string && data.fromMemberName.size() >= 1 && data.fromMemberName.size() <= 100
        && data.toMemberId is string && data.toMemberId.size() >= 1 && data.toMemberId.size() <= 128
        && data.toMemberName is string && data.toMemberName.size() >= 1 && data.toMemberName.size() <= 100
        && data.fromMemberId != data.toMemberId
        && data.qty is number && data.qty >= 1 && data.qty <= 100
        && data.note is string && data.note.size() <= 200
        && data.source in ['app', 'telegram']
        && data.status in ['pending', 'approved', 'rejected']
        && data.resolvedBy is string && data.resolvedBy.size() <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /groups/{groupId} {
      allow get: if isValidId(groupId);
      allow list: if resource.data.visibility == 'shared';
      allow create: if isValidId(groupId)
        && isValidGroup(incoming(), groupId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(groupId)
        && isValidGroup(incoming(), groupId)
        && incoming().id == existing().id
        && incoming().visibility == existing().visibility
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt is timestamp
        && incoming().updatedAt == request.time
        && (
          // Action 1: Viewer self-shift update (cannot alter group metadata, offers, matrix, settings, or member count)
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['members', 'updatedAt'])
            && incoming().members.size() == existing().members.size()
            && incoming().leaderUsername == existing().leaderUsername
          )
          // Action 2: Leader management update
          || incoming().diff(existing()).affectedKeys().hasOnly([
            'name',
            'description',
            'leaderUsername',
            'leaderDisplayName',
            'members',
            'campaigns',
            'matrix',
            'autoBackup',
            'settings',
            'completions',
            'updatedAt'
          ])
          // Action 3: Real-time CAP completion check-off update (Viewer & Leader)
          || (
            incoming().diff(existing()).affectedKeys().hasOnly(['completions', 'updatedAt'])
            && incoming().leaderUsername == existing().leaderUsername
          )
        );
      allow delete: if isValidId(groupId) && groupId != 'group-1';

      match /history/{historyId} {
        allow get: if isValidId(groupId) && isValidId(historyId)
          && exists(/databases/$(database)/documents/groups/$(groupId));
        allow list: if resource.data.groupId == groupId;
        allow create: if isValidId(groupId) && isValidId(historyId)
          && isValidHistoryRecord(incoming(), groupId, historyId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/groups/$(groupId));
        allow update: if false;
        allow delete: if isValidId(groupId) && isValidId(historyId)
          && exists(/databases/$(database)/documents/groups/$(groupId));
      }

      match /transfers/{transferId} {
        allow get: if isValidId(groupId) && isValidId(transferId)
          && exists(/databases/$(database)/documents/groups/$(groupId));
        allow list: if resource.data.groupId == groupId;
        allow create: if isValidId(groupId) && isValidId(transferId)
          && isValidTransfer(incoming(), groupId, transferId)
          && incoming().status == 'pending'
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/groups/$(groupId));
        allow update: if isValidId(groupId) && isValidId(transferId)
          && isValidTransfer(incoming(), groupId, transferId)
          && existing().status == 'pending'
          && incoming().status in ['approved', 'rejected']
          && incoming().id == existing().id
          && incoming().groupId == existing().groupId
          && incoming().date == existing().date
          && incoming().offerId == existing().offerId
          && incoming().fromMemberId == existing().fromMemberId
          && incoming().toMemberId == existing().toMemberId
          && incoming().qty == existing().qty
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'resolvedBy', 'updatedAt'])
          && exists(/databases/$(database)/documents/groups/$(groupId));
        allow delete: if isValidId(groupId) && isValidId(transferId)
          && exists(/databases/$(database)/documents/groups/$(groupId));
      }
    }

    match /groupCredentials/{groupId} {
      allow get: if isValidId(groupId)
        && exists(/databases/$(database)/documents/groups/$(groupId));
      allow list: if resource.data.username is string && request.query.limit <= 10;
      allow create: if isValidId(groupId)
        && isValidGroupCredential(incoming(), groupId)
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/groups/$(groupId));
      allow update: if isValidId(groupId)
        && isValidGroupCredential(incoming(), groupId)
        && incoming().groupId == existing().groupId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'username',
          'displayName',
          'salt',
          'passwordHash',
          'updatedAt'
        ])
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && getAfter(/databases/$(database)/documents/groups/$(groupId)).data.leaderUsername == incoming().username;
      allow delete: if isValidId(groupId)
        && groupId != 'group-1'
        && !existsAfter(/databases/$(database)/documents/groups/$(groupId));
    }

    match /groupTelegramBots/{groupId} {
      allow get: if isValidId(groupId)
        && exists(/databases/$(database)/documents/groups/$(groupId));
      allow list: if false;
      allow create: if isValidId(groupId)
        && isValidGroupTelegramBot(incoming(), groupId)
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/groups/$(groupId));
      allow update: if isValidId(groupId)
        && isValidGroupTelegramBot(incoming(), groupId)
        && incoming().groupId == existing().groupId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'botToken',
          'botUsername',
          'tokenMasked',
          'encrypted',
          'updatedAt'
        ])
        && exists(/databases/$(database)/documents/groups/$(groupId));
      allow delete: if isValidId(groupId);
    }

    match /groupSchedulerState/{groupId} {
      allow get: if isValidId(groupId)
        && exists(/databases/$(database)/documents/groups/$(groupId));
      allow list: if false;
      allow create: if isValidId(groupId)
        && isValidGroupSchedulerState(incoming(), groupId)
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/groups/$(groupId));
      allow update: if isValidId(groupId)
        && isValidGroupSchedulerState(incoming(), groupId)
        && incoming().groupId == existing().groupId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'lastShiftReminderDate',
          'lastShiftReminderSentAt',
          'lastShiftReminderStatus',
          'lastShiftReminderError',
          'lastCutoffNudgeDate',
          'lastDailySummaryDate',
          'lastDistributionSentDate',
          'lastDistributionMatrixHash',
          'lastDistributionSentAt',
          'updatedAt'
        ])
        && exists(/databases/$(database)/documents/groups/$(groupId));
      allow delete: if isValidId(groupId) && groupId != 'group-1';
    }

    match /test/{docId} {
      allow get: if docId == 'connection';
      allow list, create, update, delete: if false;
    }
  }
}
